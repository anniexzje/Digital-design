module modetraffic (input logic p,r,clk,rst,
                    output logic m);
typedef enum logic {s0,s1} statetype;
  statetype state,nextstate;
always_ff @(posedge clk,posedge rst)
    if(rst) state <=s0;
    else state <= nextstate;
  
  always_comb
    case(state)
    s0 : if(p) nextstate = s1;
      else if(~p) nextstate = s0;
    s1 : if(r) nextstate = s0;
      else if(~r) nextstate = s1;
    endcase
  assign m = (state == s1);
endmodule
module trafficlight(input logic clk,rst,
                    input logic ta,tb,m,
                    output logic [1:0] la,lb);
  typedef enum logic [1:0] {s0,s1,s2,s3} statetype;
  statetype state,nextstate;
  
  parameter logic [1:0] RED = 2'b00;
  parameter logic [1:0] YELLOW = 2'b01;
  parameter logic [1:0] GREEN = 2'b10;
  
  always_ff @(posedge clk,posedge rst)
    if(rst) state <= s0;
  else state <=nextstate;
  
  always_comb 
    case(state)
      s0 : if(~ta) nextstate = s1;
      else if(ta) nextstate = s0;
      s1 : nextstate = s2;
      s2 : if(~m & ~tb) nextstate = s3;
      else if(tb | m) nextstate = s2;
      s3 : nextstate = s0;
    endcase
  always_comb
    case(state)
      s0 : begin
        la = GREEN;
        lb = RED;
      end
      s1 : begin
        la = YELLOW;
        lb = RED;
      end
      s2 : begin
        la = RED;
        lb = GREEN;
      end
      s3 : begin
        la = RED;
        lb = YELLOW;
      end
    endcase
endmodule 
module finalfsm(input logic clk,rst,
                input logic p,r,ta,tb,
                output logic m,
                output logic [1:0] la,lb);
  modetraffic modefsm(.p(p), .r(r), .clk(clk), .rst(rst), .m(m));
  trafficlight lightfsm(.clk(clk), .rst(rst), .ta(ta), .tb(tb), .m(m), .la(la), .lb(lb));
endmodule
